rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user belongs to the requested organization
    function isUserInOrg(orgId) {
      return get(/databases/$(database)/documents/team/$(request.auth.uid)).data.organizationId == orgId;
    }

    match /team/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{collection=**}/{document} {
      allow read, write: if request.auth != null && (
        resource == null ||
        !("organizationId" in resource.data) || 
        isUserInOrg(resource.data.organizationId) ||
        (request.resource != null && "organizationId" in request.resource.data && isUserInOrg(request.resource.data.organizationId))
      );
    }
  }
}
