rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user belongs to the requested organization
    function isUserInOrg(orgId) {
      return get(/databases/$(database)/documents/team/$(request.auth.uid)).data.organizationId == orgId;
    }

    match /{collection=**}/{document} {
      // Allow if authenticated AND either the document doesn't have an orgId (initialization) 
      // OR the document's orgId matches the user's orgId in the team collection.
      allow read, write: if request.auth != null && (
        !("organizationId" in resource.data) || 
        isUserInOrg(resource.data.organizationId) ||
        isUserInOrg(request.resource.data.organizationId)
      );
    }
  }
}
