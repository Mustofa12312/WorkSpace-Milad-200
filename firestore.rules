rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Milad 200 Workspace — Firestore Security Rules
//
// Model:
//   • Every user has a profile at team/{uid} holding { organizationId, role }.
//   • All business data (tasks, projects, documents, events) carries an
//     organizationId and is only visible/writable to members of that org.
//   • Roles: Owner > Admin > Manager > Member.
//       - Owner/Admin may invite & manage members and delete data.
//       - Only an Owner may grant the Owner role.
//   • Anything not explicitly allowed below is DENIED.
//
// NOTE: Rules are not filters. Clients must query with
//   where('organizationId', '==', <orgId>)  (see src/store/useAppStore.ts).
//
// Tested in tests/rules/firestore.rules.test.ts  →  npm run test:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Real invitation system removes the default-org-1 hack.

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/team/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function myOrg() { return me().organizationId; }
    function isManager() { return me().role in ['Owner', 'Admin']; }
    function isOwner() { return me().role == 'Owner'; }
    function validRole(role) { return role in ['Owner', 'Admin', 'Manager', 'Member', 'Viewer']; }

    function inMyOrg(data) {
      return hasProfile() && data.organizationId is string && data.organizationId == myOrg();
    }
    // organizationId may never be changed on update (prevents moving/hijacking docs).
    function orgUnchanged() {
      return request.resource.data.organizationId == resource.data.organizationId;
    }
    function canGrant(role) { return validRole(role) && (role != 'Owner' || isOwner()); }

    function canEdit() { return me().role != 'Viewer'; }

    // ── Team / user profiles ────────────────────────────────────────────────
    match /team/{memberId} {
      allow read: if signedIn() && (
        request.auth.uid == memberId ||
        inMyOrg(resource.data)
      );

      allow create: if signedIn() && (
        // Self-provisioning a NEW organization. User becomes Owner.
        (
          request.auth.uid == memberId &&
          request.resource.data.id == memberId &&
          request.resource.data.role == 'Owner' &&
          request.resource.data.organizationId == memberId
        ) ||
        // Accepting an invitation.
        (
          request.auth.uid == memberId &&
          request.resource.data.id == memberId &&
          request.resource.data.keys().hasAll(['inviteId', 'email']) &&
          exists(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)) &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.organizationId == request.resource.data.organizationId &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.role == request.resource.data.role &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.email == request.resource.data.email
        ) ||
        // Invitation by an Owner/Admin into their own org.
        (
          request.auth.uid != memberId &&
          hasProfile() && isManager() &&
          request.resource.data.organizationId == myOrg() &&
          canGrant(request.resource.data.role)
        )
      );

      allow update: if signedIn() && (
        // Users may edit their own profile but never their role or organization.
        (
          request.auth.uid == memberId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'organizationId', 'id', 'inviteId'])
        ) ||
        // Owner/Admin may manage members of their own org.
        (
          inMyOrg(resource.data) && isManager() && orgUnchanged() &&
          canGrant(request.resource.data.role) &&
          (resource.data.role != 'Owner' || isOwner())
        )
      );

      allow delete: if inMyOrg(resource.data) && isManager() &&
        request.auth.uid != memberId &&
        (resource.data.role != 'Owner' || isOwner());
    }

    // ── Org-scoped business data ────────────────────────────────────────────

    match /tasks/{id} {
      allow read: if inMyOrg(resource.data);
      allow create: if inMyOrg(request.resource.data) && canEdit();
      allow update: if inMyOrg(resource.data) && orgUnchanged() && canEdit();
      allow delete: if inMyOrg(resource.data) && canEdit();
    }

    match /projects/{id} {
      allow read: if inMyOrg(resource.data);
      allow create: if inMyOrg(request.resource.data) && canEdit();
      allow update: if inMyOrg(resource.data) && orgUnchanged() && canEdit();
      allow delete: if inMyOrg(resource.data) && canEdit();
    }

    match /documents/{id} {
      allow read: if inMyOrg(resource.data);
      allow create: if inMyOrg(request.resource.data) && canEdit();
      allow update: if inMyOrg(resource.data) && orgUnchanged() && canEdit();
      allow delete: if inMyOrg(resource.data) && canEdit();
    }

    match /events/{id} {
      allow read: if inMyOrg(resource.data);
      allow create: if inMyOrg(request.resource.data) && canEdit();
      allow update: if inMyOrg(resource.data) && orgUnchanged() && canEdit();
      allow delete: if inMyOrg(resource.data) && canEdit();
    }

    match /meetings/{id} {
      allow read: if inMyOrg(resource.data);
      allow create: if inMyOrg(request.resource.data) && canEdit();
      allow update: if inMyOrg(resource.data) && orgUnchanged() && canEdit();
      allow delete: if inMyOrg(resource.data) && canEdit();
    }

    match /invitations/{id} {
      allow get: if true; // Anyone with the link can fetch the invitation
      allow list: if inMyOrg(resource.data) && isManager();
      allow create: if inMyOrg(request.resource.data) && isManager();
      allow update: if false;
      allow delete: if (inMyOrg(resource.data) && isManager()) || (signedIn() && resource.data.email == request.auth.token.email);
    }

    match /auditLogs/{id} {
      allow read: if inMyOrg(resource.data) && isManager(); // Only managers can read audit logs
      allow create: if inMyOrg(request.resource.data);
      allow update, delete: if false; // Immutable
    }

    // Everything else is denied by default (no catch-all match).
  }
}
